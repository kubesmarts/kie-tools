set -e

SOURCES_DIR=/tmp/artifacts
MAVEN_DIST="${SOURCES_DIR}"/apache-maven-3.9.16-bin.tar.gz

# MAVEN_HOME/MAVEN_CMD (set by org.kie.kogito.maven.common) expect Maven at
# /usr/share/maven with the launcher at /usr/share/maven/bin/mvn.
echo "---> Installing Apache Maven into /usr/share/maven"
mkdir -p /usr/share/maven
tar -xzf "${MAVEN_DIST}" -C /usr/share/maven --strip-components=1

# Expose mvn on the PATH, mirroring the openjdk base image layout.
ln -sfn /usr/share/maven/bin/mvn /usr/bin/mvn

# Sanity check
mvn --version
