set -e

# The openjdk-17-runtime base image exposed JAVA_HOME=/usr/lib/jvm/jre.
# The java-17-openjdk-headless RPM installs into a versioned directory and
# registers /usr/bin/java via alternatives, so resolve the real runtime home
# and publish it at the stable /usr/lib/jvm/jre path used by JAVA_HOME.
java_bin="$(readlink -f "$(command -v java)")"
java_home="$(dirname "$(dirname "${java_bin}")")"

echo "---> Resolved Java runtime home: ${java_home}"
ln -sfn "${java_home}" /usr/lib/jvm/jre

# Sanity check
"${JAVA_HOME}"/bin/java -version
